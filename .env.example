VITE_STEAM_PROXY_URL=https://your-vercel-project.vercel.app/api/steam-profile
STEAM_PROFILE_ID=your-public-steam-id-or-vanity
STEAM_SHOWCASE_APPIDS=730,570,271590

# Public Web3Forms access key used by the recruiter contact form.
# Vite inlines VITE_ variables into the client bundle, so this is not a secret,
# but it should live in the environment so it can be rotated without a code change.
# Set VITE_WEB3FORMS_KEY in the Vercel project for both Production and Preview
# before relying on the contact form. If it is missing, the form tells visitors
# to email hi@vaibhavmodi.com instead of failing silently.
VITE_WEB3FORMS_KEY=your-web3forms-access-key
